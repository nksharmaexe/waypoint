{
  "name": "waypoint",
  "displayName": "Waypoint - Git Snapshots",
  "icon": "media/icon.png",
  "description": "Save hidden snapshots between steps, with no commits, and diff any step against the last.",
  "version": "0.1.1",
  "publisher": "nksharmaexe",
  "license": "MIT",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nksharmaexe/waypoint"
  },
  "bugs": {
    "url": "https://github.com/nksharmaexe/waypoint/issues"
  },
  "keywords": [
    "git",
    "snapshot",
    "checkpoint",
    "diff",
    "undo",
    "local history"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waypoint",
          "title": "Waypoint",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "waypoint": [
        {
          "id": "waypointView",
          "name": "Checkpoints",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "waypointView",
        "contents": "Open a folder to start saving checkpoints.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "waypoint.state == 'nofolder'"
      },
      {
        "view": "waypointView",
        "contents": "This folder isn't a git repository. Waypoint stores its checkpoints inside git.\n[Initialize Repository](command:waypoint.initRepo)",
        "when": "waypoint.state == 'norepo'"
      },
      {
        "view": "waypointView",
        "contents": "Waypoint couldn't run git. Install git, make sure it's on your PATH, then reload.\n[Reload Window](command:workbench.action.reloadWindow)",
        "when": "waypoint.state == 'nogit'"
      }
    ],
    "commands": [
      {
        "command": "waypoint.restoreFile",
        "title": "Restore This File",
        "icon": "$(discard)"
      },
      {
        "command": "waypoint.initRepo",
        "title": "Initialize Repository",
        "category": "Waypoint"
      },
      {
        "command": "waypoint.beforeAgent",
        "title": "Checkpoint Before Agent",
        "category": "Waypoint"
      },
      {
        "command": "waypoint.create",
        "title": "Create Checkpoint",
        "icon": "$(add)"
      },
      {
        "command": "waypoint.refresh",
        "title": "Refresh Checkpoints",
        "icon": "$(refresh)"
      },
      {
        "command": "waypoint.clear",
        "title": "Clear All Checkpoints",
        "icon": "$(clear-all)"
      },
      {
        "command": "waypoint.restore",
        "title": "Restore Checkpoint"
      },
      {
        "command": "waypoint.delete",
        "title": "Delete Checkpoint"
      },
      {
        "command": "waypoint.selectForCompare",
        "title": "Select for Compare"
      },
      {
        "command": "waypoint.compareWithSelected",
        "title": "Compare with Selected"
      },
      {
        "command": "waypoint.clearComparison",
        "title": "Close Comparison",
        "icon": "$(close)"
      },
      {
        "command": "waypoint.compareWithWorking",
        "title": "Compare with Working Changes"
      },
      {
        "command": "waypoint.filter",
        "title": "Filter Files",
        "icon": "$(search)"
      },
      {
        "command": "waypoint.clearFilter",
        "title": "Clear Filter",
        "icon": "$(search-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "waypoint.create",
          "when": "view == waypointView",
          "group": "navigation@1"
        },
        {
          "command": "waypoint.refresh",
          "when": "view == waypointView",
          "group": "navigation@2"
        },
        {
          "command": "waypoint.clear",
          "when": "view == waypointView",
          "group": "navigation@3"
        },
        {
          "command": "waypoint.filter",
          "when": "view == waypointView",
          "group": "navigation@4"
        },
        {
          "command": "waypoint.clearFilter",
          "when": "view == waypointView && waypoint.filterActive",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "waypoint.restoreFile",
          "when": "viewItem == restorableFile",
          "group": "inline"
        },
        {
          "command": "waypoint.restoreFile",
          "when": "viewItem == restorableFile",
          "group": "2_manage@1"
        },
        {
          "command": "waypoint.selectForCompare",
          "when": "viewItem == checkpoint",
          "group": "1_compare@1"
        },
        {
          "command": "waypoint.compareWithSelected",
          "when": "viewItem == checkpoint",
          "group": "1_compare@2"
        },
        {
          "command": "waypoint.restore",
          "when": "viewItem == checkpoint",
          "group": "2_manage@1"
        },
        {
          "command": "waypoint.delete",
          "when": "viewItem == checkpoint",
          "group": "2_manage@2"
        },
        {
          "command": "waypoint.clearComparison",
          "when": "viewItem == comparison",
          "group": "inline"
        },
        {
          "command": "waypoint.compareWithWorking",
          "when": "viewItem == checkpoint",
          "group": "1_compare@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "waypoint.create",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "Waypoint",
      "properties": {
        "waypoint.autoIntervalMinutes": {
          "type": "number",
          "default": 0,
          "description": "Create an automatic checkpoint every N minutes if files changed. 0 = off."
        },
        "waypoint.safety.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save a checkpoint before pulls, checkouts, resets, rebases and bulk file changes."
        },
        "waypoint.safety.bulkChangeThreshold": {
          "type": "number",
          "default": 6,
          "description": "How many files changed outside the editor count as a bulk change (agents, discard all, codegen)."
        },
        "waypoint.safety.keep": {
          "type": "number",
          "default": 10,
          "description": "How many automatic safety checkpoints to keep."
        },
        "waypoint.autoKeep": {
          "type": "number",
          "default": 20,
          "description": "How many automatic checkpoints to keep."
        },
        "waypoint.onCommit": {
          "type": "string",
          "enum": [
            "ask",
            "clear",
            "keep"
          ],
          "default": "ask",
          "description": "What to do with checkpoints after you make a commit."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
